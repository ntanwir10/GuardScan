{
  "name": "guardscan",
  "version": "1.1.0",
  "description": "GuardScan - Privacy-first AI Code Review CLI with comprehensive security scanning",
  "main": "dist/index.js",
  "bin": {
    "guardscan": "dist/index.js"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.js",
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "lint:strict": "eslint src --ext .ts",
    "lint:ratchet": "node scripts/eslint-ratchet.js",
    "lint:ratchet:update": "node scripts/eslint-ratchet.js --write-baseline",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "start": "node dist/index.js",
    "test": "jest",
    "test:package": "node scripts/package-smoke.js",
    "test:package-manager": "node scripts/package-manager-smoke.js",
    "test:release": "jest __tests__/contracts/release-contracts.test.ts __tests__/release/artifact-determinism.test.ts __tests__/release/pull-request-policy.test.ts __tests__/scripts/release-tool.test.ts __tests__/scripts/release-train.test.ts __tests__/scripts/release-workflows.test.ts __tests__/scripts/release-renderers.test.ts __tests__/scripts/release-please-config.test.ts __tests__/scripts/release-credential-monitor.test.ts __tests__/scripts/checkpoint.test.ts __tests__/scripts/package-manager-smoke.test.ts __tests__/scripts/standalone-builder.test.ts __tests__/scripts/catalog-workflow.test.ts __tests__/scripts/release-governance.test.ts __tests__/scripts/deterministic-serialization.test.ts __tests__/scripts/release-canary.test.ts --runInBand",
    "release": "node scripts/release/index.js",
    "release:validate": "node scripts/release/index.js validate",
    "release:build": "node scripts/release/index.js build",
    "release:manifest": "node scripts/release/index.js manifest",
    "release:publish": "node scripts/release/index.js publish",
    "release:verify": "node scripts/release/index.js verify",
    "release:reconcile": "node scripts/release/index.js reconcile",
    "release:promote": "node scripts/release/index.js promote",
    "release:rollback": "node scripts/release/index.js rollback",
    "release:plan": "node scripts/release/index.js plan",
    "release:prepare": "node scripts/release/index.js prepare",
    "release:dry-run": "node scripts/release/index.js dry-run",
    "release:render": "node scripts/release/index.js render",
    "release:validate-adapters": "node scripts/release/index.js validate-adapters",
    "release:standalone-prototype": "npm run build && node scripts/release/index.js standalone-prototype",
    "release:package": "node scripts/release/index.js package",
    "release:verify-npm": "node scripts/release/index.js verify-npm-artifact",
    "release:npm-preflight": "node scripts/release/index.js npm-preflight",
    "release:advance": "node scripts/release/index.js advance",
    "release:status": "node scripts/release/index.js status",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "keywords": [
    "guardscan",
    "code-review",
    "security-scanner",
    "sast",
    "vulnerability-scanner",
    "ai-code-review",
    "static-analysis",
    "code-analysis",
    "openai",
    "claude",
    "gemini",
    "ollama",
    "privacy-first",
    "open-source"
  ],
  "author": "Nauman Tanwir <ntanwir10@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ntanwir10/GuardScan.git",
    "directory": "cli"
  },
  "homepage": "https://guardscancli.com",
  "bugs": {
    "url": "https://github.com/ntanwir10/GuardScan/issues"
  },
  "files": [
    "dist/",
    "schemas/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@google/generative-ai": "^0.1.3",
    "ae-cvss-calculator": "1.0.13",
    "axios": "^1.6.2",
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "commander": "^11.1.0",
    "fast-glob": "^3.3.2",
    "ignore": "^5.3.0",
    "inquirer": "^8.2.5",
    "js-yaml": "^4.3.1",
    "marked": "^11.0.0",
    "openai": "^6.9.0",
    "ora": "^5.4.1",
    "semver": "^7.7.3",
    "typescript": "^5.3.3",
    "uuid": "^11.1.1"
  },
  "optionalDependencies": {
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "tiktoken": "^1.0.0"
  },
  "devDependencies": {
    "@jest/test-sequencer": "^29.7.0",
    "@stryker-mutator/core": "^9.3.0",
    "@types/cli-progress": "^3.11.6",
    "@types/inquirer": "^8.2.10",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "ajv": "^8.20.0",
    "ajv-draft-04": "1.0.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.1",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "postject": "1.0.0-alpha.6",
    "ts-jest": "^29.4.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "brace-expansion@<1.1.18": "1.1.18",
    "qs": "6.15.3"
  }
}
