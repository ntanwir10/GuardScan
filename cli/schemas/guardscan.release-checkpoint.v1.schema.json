{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://guardscancli.com/schemas/guardscan.release-checkpoint.v1.schema.json",
  "title": "GuardScan deterministic release checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "tag", "commit", "createdAt", "producer", "archive", "files"],
  "properties": {
    "schemaVersion": { "const": "guardscan.release-checkpoint.v1" },
    "version": { "$ref": "#/definitions/semver" },
    "tag": { "$ref": "#/definitions/versionTag" },
    "commit": { "$ref": "#/definitions/commit" },
    "createdAt": { "type": "string", "format": "date-time" },
    "producer": { "$ref": "#/definitions/producer" },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "format", "size", "sha256"],
      "properties": {
        "filename": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*\\.tar\\.gz$" },
        "format": { "const": "tar.gz" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "mode", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._+@-]+(?:/[A-Za-z0-9._+@-]+)*$" },
          "size": { "type": "integer", "minimum": 0 },
          "mode": { "type": "string", "pattern": "^[0-7]{4}$" },
          "sha256": { "$ref": "#/definitions/sha256" }
        }
      }
    }
  },
  "definitions": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "versionTag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "workflow", "runId", "runAttempt", "sourceRef"],
      "properties": {
        "provider": { "const": "github-actions" },
        "repository": { "const": "ntanwir10/GuardScan" },
        "workflow": { "type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.yml$" },
        "runId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "sourceRef": { "type": "string", "pattern": "^refs/(heads|tags)/[A-Za-z0-9._/-]+$" }
      }
    }
  }
}
