{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://guardscancli.com/schemas/guardscan.release-event.v1.schema.json",
  "title": "GuardScan append-only release event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "tag",
    "commit",
    "sequence",
    "previousHash",
    "timestamp",
    "type",
    "idempotencyKey",
    "payload",
    "eventHash"
  ],
  "properties": {
    "schemaVersion": { "const": "guardscan.release-event.v1" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sequence": { "type": "integer", "minimum": 1 },
    "previousHash": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      ]
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "type": {
      "enum": [
        "train_started",
        "artifact_built",
        "artifact_signed",
        "manifest_created",
        "channel_published",
        "channel_submitted",
        "channel_accepted",
        "channel_verified",
        "channel_failed",
        "canary_recorded",
        "promotion_decided",
        "rollback_started",
        "action_required",
        "withdrawn",
        "superseded",
        "incident_opened",
        "incident_resolved"
      ]
    },
    "channel": {
      "enum": [
        "npm",
        "pnpm",
        "yarn",
        "bun",
        "github",
        "homebrew",
        "homebrew-core",
        "scoop",
        "winget",
        "chocolatey",
        "pypi"
      ]
    },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 200 },
    "payload": { "type": "object", "maxProperties": 30 },
    "eventHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
